# Скопируйте этот файл в .env и заполните. Файл .env в Git не попадает.

# Пароль для страницы /admin (логин: admin). Только латинские буквы и цифры.
# Если пусто, админка выключена. На Render (боевой сервер) пароль должен быть
# не короче 12 символов и не быть паролем из этого примера, иначе админка отключится.
ADMIN_PASSWORD=MyDemoPass2026

# Ключ подписи токенов формы: любая длинная случайная строка.
# Если пусто, при каждом запуске создаётся новый (на Render он создаётся сам через render.yaml).
SECRET_KEY=

# Сколько запросов в минуту разрешено с одного адреса (остальные получат 429)
RATE_LIMIT_PER_MIN=240

# Где лежит база SQLite
DB_PATH=data/shop.db

# Документация API на /docs (только для разработки)
ENABLE_DOCS=1

# Необязательно: пускать запросы только на свои домены, через запятую.
# Включайте после проверки, и не забудьте добавить localhost для работы у себя.
# ALLOWED_HOSTS=example.com,www.example.com
